{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cosmin-sisman/agent-os/schema/agent-os.schema.json",
  "title": "agent-os team configuration (agent-os.json)",
  "type": "object",
  "description": "agent-os configuration",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema, for editors"
    },
    "version": {
      "type": "string",
      "description": "The exact agent-os version this project is pinned to",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "greenfield",
        "spec-first",
        "active",
        "maintenance"
      ],
      "description": "Where the project is in its life",
      "default": "active"
    },
    "platform": {
      "type": "object",
      "description": "Which platform and project agent-os talks to",
      "default": {},
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "description": "The code platform",
          "default": "github"
        },
        "host": {
          "type": "string",
          "description": "Base URL for GitHub Enterprise Server or GitLab self-managed; omit for github.com and gitlab.com",
          "pattern": "^https?://"
        },
        "project": {
          "type": "string",
          "description": "owner/name (GitHub) or group/subgroup/name (GitLab)",
          "pattern": "^[^/\\s]+(/[^/\\s]+)+$"
        },
        "caFile": {
          "type": "string",
          "description": "Private CA bundle for a self-managed host, relative to the repository"
        },
        "board": {
          "type": "object",
          "description": "The planning board (GitHub Projects v2) issues are placed on, when there is one",
          "properties": {
            "owner": {
              "type": "string",
              "description": "The user or organization that owns the board"
            },
            "number": {
              "type": "integer",
              "description": "The board (GitHub Project) number",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "branches": {
      "type": "object",
      "description": "Branch roles",
      "default": {},
      "properties": {
        "integration": {
          "type": "string",
          "description": "Feature PRs and MRs target this branch; it is the default branch",
          "default": "development"
        },
        "production": {
          "type": "string",
          "description": "Releases merge into this branch",
          "default": "main"
        },
        "requiredChecks": {
          "type": "array",
          "description": "Checks that must pass before merging into either branch",
          "default": [],
          "items": {
            "type": "string",
            "description": "A check name, such as ci"
          }
        },
        "requiredApprovals": {
          "type": "integer",
          "description": "Approving reviews required on pull or merge requests",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "description": "Language per area",
      "default": {},
      "properties": {
        "issues": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Issue titles, bodies and comments the agent starts (en, or ro written without diacritics)",
          "default": "en"
        },
        "prs": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Pull or merge request titles, descriptions and comments (en, or ro written without diacritics)",
          "default": "en"
        },
        "commits": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Commit messages (en, or ro written without diacritics)",
          "default": "en"
        },
        "branches": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Branch slugs (en, or ro written without diacritics)",
          "default": "en"
        },
        "labels": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Label names and descriptions (en, or ro written without diacritics)",
          "default": "en"
        },
        "milestones": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Milestone titles and descriptions (en, or ro written without diacritics)",
          "default": "en"
        },
        "releases": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Release notes (en, or ro written without diacritics)",
          "default": "en"
        },
        "codeComments": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Comments written in code (en, or ro written without diacritics)",
          "default": "en"
        },
        "docs": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Human documentation in docs/ (en, or ro written without diacritics)",
          "default": "en"
        },
        "journal": {
          "type": "string",
          "enum": [
            "en",
            "ro"
          ],
          "description": "Journal entries and decision records (en, or ro written without diacritics)",
          "default": "en"
        }
      },
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "description": "Title and commit message conventions",
      "default": {},
      "properties": {
        "types": {
          "type": "array",
          "description": "Allowed types in change-request titles and commit subjects",
          "default": [
            "feat",
            "fix",
            "docs",
            "chore",
            "refactor",
            "perf",
            "test",
            "ci",
            "build",
            "style",
            "revert"
          ],
          "items": {
            "type": "string",
            "description": "A change type"
          }
        },
        "maxTitleLength": {
          "type": "integer",
          "description": "Longest change-request title or commit subject, issue suffix included",
          "minimum": 30,
          "maximum": 200,
          "default": 72
        },
        "exempt": {
          "type": "array",
          "description": "Titles exempt from the checks (syncs, bots)",
          "default": [
            "^chore: sync \\S+ into \\S+$",
            "^(chore|build)\\(deps(-dev)?\\): "
          ],
          "items": {
            "type": "string",
            "description": "A regular expression; matching titles are not checked"
          }
        }
      },
      "additionalProperties": false
    },
    "packs": {
      "type": "array",
      "description": "Optional packs installed in this project",
      "default": [],
      "items": {
        "type": "string",
        "description": "A pack id"
      }
    },
    "slots": {
      "type": "object",
      "description": "Capability slots and the skills bound to them",
      "default": {},
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "description": "The skill bound to this slot, or null for none"
      }
    },
    "gate": {
      "type": "object",
      "description": "Test and check suites by name",
      "default": {},
      "additionalProperties": {
        "type": "string",
        "description": "The command that runs this suite"
      }
    },
    "requires": {
      "type": "object",
      "description": "What a working setup needs, checked by agent-os env",
      "default": {},
      "properties": {
        "mcp": {
          "type": "array",
          "description": "MCP servers the project needs",
          "default": [],
          "items": {
            "type": "object",
            "description": "One MCP server",
            "required": [
              "name",
              "scope"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Server name as registered in Claude Code"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "project",
                  "user"
                ],
                "description": "Where the server is configured"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ],
                "description": "How the server is reached"
              },
              "url": {
                "type": "string",
                "description": "http/sse: the server URL, used in the fix command",
                "pattern": "^https?://"
              },
              "command": {
                "type": "string",
                "description": "stdio: the command that starts the server, used in the fix command"
              },
              "optional": {
                "type": "boolean",
                "description": "A missing optional server is a warning, not a failure",
                "default": false
              },
              "why": {
                "type": "string",
                "description": "What needs it"
              }
            },
            "additionalProperties": false
          }
        },
        "cli": {
          "type": "object",
          "description": "Command-line tools and their versions",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "description": "A semver range, or * for any version"
          }
        },
        "platformScopes": {
          "type": "array",
          "description": "Token scopes the platform CLI needs",
          "default": [],
          "items": {
            "type": "string",
            "description": "A token scope"
          }
        },
        "env": {
          "type": "array",
          "description": "Variables that must be set (values are never read)",
          "default": [],
          "items": {
            "type": "string",
            "description": "An environment variable name",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "plugins": {
          "type": "array",
          "description": "Plugins the project expects",
          "default": [],
          "items": {
            "type": "string",
            "description": "A Claude Code plugin"
          }
        }
      },
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "description": "Feedback to the agent-os project",
      "default": {},
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Allow /upstream to file issues on the public agent-os repository",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "description": "Compliance constraints",
      "default": {},
      "properties": {
        "euOnly": {
          "type": "boolean",
          "description": "Flag providers without confirmed EU regions",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "contextBudgets": {
      "type": "object",
      "description": "Size budgets per file or glob",
      "default": {},
      "additionalProperties": {
        "type": "string",
        "description": "A size such as 8KB",
        "pattern": "^\\d+(\\.\\d+)?\\s?(B|KB|MB)$"
      }
    },
    "legacy": {
      "type": "array",
      "description": "Legacy features this project keeps enabled",
      "default": [],
      "items": {
        "type": "string",
        "description": "A legacy feature id"
      }
    },
    "guards": {
      "type": "object",
      "description": "Guards that refuse risky shell commands before they run (PreToolUse)",
      "default": {},
      "properties": {
        "rules": {
          "type": "array",
          "description": "Project guard rules, added to the built-in ones",
          "default": [],
          "items": {
            "type": "object",
            "description": "One guard rule",
            "required": [
              "id",
              "type",
              "pattern"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "A short name, shown when the rule refuses something"
              },
              "type": {
                "type": "string",
                "enum": [
                  "forbid-flags",
                  "forbid-pattern",
                  "require-env",
                  "min-free-memory"
                ],
                "description": "What the rule checks"
              },
              "pattern": {
                "type": "string",
                "description": "A regular expression matched against each shell command (after splitting on && || ; |)"
              },
              "flags": {
                "type": "array",
                "description": "forbid-flags: flags refused after a matching command",
                "default": [],
                "items": {
                  "type": "string",
                  "description": "A flag such as --no-verify"
                }
              },
              "env": {
                "type": "string",
                "description": "require-env: the variable that must be set, e.g. DB_RESET_OK=1 in the command or the environment",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "message": {
                "type": "string",
                "description": "What to tell the agent when the rule refuses"
              }
            },
            "additionalProperties": false
          }
        },
        "disable": {
          "type": "array",
          "description": "Built-in guards turned off for this project",
          "default": [],
          "items": {
            "type": "string",
            "description": "The id of a built-in guard"
          }
        }
      },
      "additionalProperties": false
    },
    "adoption": {
      "type": "object",
      "description": "Adoption mode for projects new to agent-os",
      "default": {},
      "properties": {
        "warnOnlyUntil": {
          "type": "string",
          "description": "Until this date (YYYY-MM-DD) guards only warn instead of refusing",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
